---
import Base from '../../layouts/Base.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import { getCollection } from 'astro:content';
import { candidatesFor, type Ranking } from '../../lib/rankings';
import { TIERS, editorTier } from '../../lib/tiers';

export async function getStaticPaths() {
  const all = await getCollection('rankings');
  return all.map((r) => ({ params: { slug: r.id }, props: { r, all } }));
}

const { r, all } = Astro.props as { r: Ranking; all: Ranking[] };
const d = r.data;
const labelOf = (id: string) => d.bases.find((b) => b.id === id)?.label ?? id;
const fmt = (x: Date) => `${x.getFullYear()}/${x.getMonth() + 1}/${x.getDate()}`;

// 「据え置く」「評価を変える材料はない」だけの判定理由は、前の勢の理由を引き継いで見せる
const PLACEHOLDER = /据え置|評価を変える材料はない|変える材料はない/;
function noteFor(c: Ranking['data']['candidates'][number], i: number): string | undefined {
  const own = c.editor[d.bases[i].id]?.note;
  if (!own || !PLACEHOLDER.test(own) || own.length > 40) return own;
  for (let k = i - 1; k >= 0; k--) {
    const prev = c.editor[d.bases[k].id]?.note;
    if (prev && !PLACEHOLDER.test(prev)) return `${prev}（${d.bases[i].label}の範囲でも評価は変わらない）`;
  }
  return own;
}

const panels = d.bases.map((b, i) => {
  const list = candidatesFor(r, b.id)
    .map((c) => ({ c, j: c.editor[b.id], note: noteFor(c, i), tier: editorTier(c.editor[b.id]?.score ?? 0) }))
    .sort((x, y) => (y.j?.score ?? 0) - (x.j?.score ?? 0));
  return { b, i, list };
});

// 勢が1つだけの作品では「〇〇勢に分けて」と書かない
const description =
  d.bases.length > 1
    ? d.description
    : `${d.work}の最強キャラをティア表で決めます。候補キャラを全員並べて投稿すると、みんなのティア表に反映されます。`;
const tabLabel = d.bases.length > 1 ? `【${d.bases.map((b) => b.label).join('・')}別】` : '';

// クライアント側で使う候補情報（勢ごと）
const clientData = Object.fromEntries(
  panels.map(({ b, list }) => [
    b.id,
    list.map(({ c, j, tier }) => ({ id: c.id, name: c.name, editorScore: j?.score ?? 0, editorTier: tier })),
  ])
);

const related = (d.related.length
  ? (d.related.map((id) => all.find((x) => x.id === id)).filter(Boolean) as Ranking[])
  : all.filter((x) => x.id !== r.id).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf() || a.id.localeCompare(b.id))
).slice(0, 8);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: d.title,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: panels[0].list.map(({ c }, idx) => ({ '@type': 'ListItem', position: idx + 1, name: c.name })),
};
---
<Base title={`${d.work} 最強キャラランキング${tabLabel || '【ティア表】'}`} description={description} jsonLd={jsonLd}>
  <nav class="crumbs" aria-label="パンくず">
    <span><a href="/">トップ</a></span><span><a href="/rankings/">作品一覧</a></span><span>{d.work}</span>
  </nav>

  <div class="box rk-head" data-ranking={r.id} data-work={d.work}>
    <h1>{tabLabel && <span class="pre">{tabLabel}</span>}{d.work} 最強キャラ ティア表</h1>
    <dl class="stats">
      <div><dt>候補キャラ</dt><dd data-stat="count">{panels[0].list.length}<small>人</small></dd></div>
      <div><dt>投稿されたティア表</dt><dd data-stat="posts">-<small>件</small></dd></div>
      <div><dt>最終更新</dt><dd style="font-size:13px;padding-top:4px">{fmt(d.updated)}</dd></div>
    </dl>
    <ul class="rk-notes">
      <li>候補キャラを全員 S〜D に並べきると、あなたのティア表を投稿できます。ログイン不要、あとから並べ直せます。</li>
      <li>みんなの投稿を平均したものが「みんなのティア表」です。見ている範囲（{d.bases.map((b) => b.label).join('・')}）ごとに別々に集計します。</li>
      <li>運営のティア表の基準は<a href="/rules/">ルール</a>にまとめています。</li>
    </ul>
  </div>

  <div class="basis-tabs" role="tablist" aria-label="どこまで見ているか">
    {d.bases.map((b, i) => (
      <button class="basis-tab" role="tab" data-basis={b.id} aria-selected={i === 0 ? 'true' : 'false'}>
        {b.label}<small>{b.range}</small>
      </button>
    ))}
  </div>

  {panels.map(({ b, i, list }) => (
    <section class="basis-panel" data-basis={b.id} hidden={i !== 0}>
      {i > 0 && (
        <div class="box spoiler-gate" data-gate>
          <p>このタブは<strong>{b.range}</strong>の内容を前提にしています。<br />候補キャラ・判定理由・投稿にネタバレを含みます。</p>
          <button class="btn btn-main" type="button" data-open>{b.label}のティア表を表示する</button>
        </div>
      )}
      <div data-body hidden={i > 0}>
        <!-- 表示用ティア表 -->
        <div class="box tl-view">
          <div class="sort-tabs" role="tablist" aria-label="どちらのティア表を見るか">
            <button class="sort-tab" role="tab" data-view="crowd" aria-selected="false">みんなのティア表</button>
            <button class="sort-tab" role="tab" data-view="editor" aria-selected="true">運営のティア表</button>
          </div>
          <p class="sort-help" data-help>作中の描写をもとに運営が並べたティア表です。</p>
          <div class="tl-board" data-board>
            {TIERS.map((t) => (
              <div class="tl-row" data-tier={t.id}>
                <div class="tl-label" style={`background:${t.color}`}>{t.id}</div>
                <div class="tl-cells">
                  {list.filter((x) => x.tier === t.id).map(({ c }) => <span class="tl-chip"><i>{list.findIndex((y) => y.c.id === c.id) + 1}</i>{c.name}</span>)}
                </div>
              </div>
            ))}
          </div>
          <p class="tl-legend">上の段ほど強く、同じ段の中では<b>左にいるほど強い</b>順です。数字は全体の順位です。</p>
          <button type="button" class="btn btn-main btn-wide" data-make>自分のティア表を作って投稿する</button>
        </div>

        <!-- 作成用ティア表 -->
        <div class="box tl-maker" data-maker hidden>
          <h2 class="sec-title" style="margin-top:0">あなたのティア表（{b.label}）</h2>
          <p class="maker-help">キャラをタップして選び、置きたい段をタップしてください。<b>同じ段の中では左にいるほど強い</b>扱いです。選んだまま段の中のキャラをタップすると、そのキャラの左に入ります。パソコンではドラッグでも動かせます。</p>
          <div class="tl-board is-edit" data-edit>
            {TIERS.map((t) => (
              <div class="tl-row" data-tier={t.id} data-drop>
                <div class="tl-label" style={`background:${t.color}`}>{t.id}</div>
                <div class="tl-cells"></div>
              </div>
            ))}
          </div>
          <div class="tl-selbar" data-selbar hidden>
            <span>選択中：<b data-selname></b></span>
            <button type="button" class="btn" data-move="-1">◀ 左へ</button>
            <button type="button" class="btn" data-move="1">右へ ▶</button>
            <button type="button" class="btn" data-unplace>外す</button>
          </div>
          <div class="tl-pool" data-pool data-drop>
            <p class="tl-pool-head">まだ置いていないキャラ <b data-left>{list.length}</b>人</p>
            <div class="tl-cells">
              {list.map(({ c }) => <button type="button" class="tl-chip is-move" data-id={c.id} draggable="true" title={c.affiliation}><i></i>{c.name}</button>)}
            </div>
          </div>
          <form class="tl-form" data-form>
            <textarea name="body" maxlength="500" placeholder="ひとこと（任意）。例：Sの順番は迷った。〇〇戦を見るとこう並べるしかない。"></textarea>
            <div class="rf-row">
              <input type="text" name="name" maxlength="20" placeholder="名前（空欄なら「名無しさん」）" autocomplete="nickname" />
              <label><input type="checkbox" name="spoiler" /> ネタバレを含む</label>
            </div>
            <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="rf-actions">
              <button type="button" class="btn" data-reset>はじめから</button>
              <button type="button" class="btn" data-close>閉じる</button>
              <button type="submit" class="btn btn-main" data-submit disabled>あと{list.length}人並べると投稿できます</button>
            </div>
            <p class="rf-msg" hidden></p>
          </form>
        </div>

        <!-- キャラ別の内訳 -->
        <h2 class="sec-title">キャラ別の評価</h2>
        <ol class="cands">
          {list.map(({ c, j, note, tier }, idx) => (
            <li class="cand" data-c={c.id} data-editor={j?.score ?? 0} data-pos={idx + 1}>
              <div class="cand-top">
                <div class="rank"><b data-rank>{idx + 1}</b><span>位</span></div>
                <div class="cand-main">
                  <h3 class="cand-name">{c.name}</h3>
                  <div class="cand-attrs">
                    {c.affiliation && <span class="attr">{c.affiliation}</span>}
                    {c.cv && <span class="attr">CV: {c.cv}</span>}
                    {i > 0 && c.appears === b.id && <span class="attr attr-new">{labelOf(c.appears)}で登場</span>}
                  </div>
                  <dl class="scores">
                    <div class="score-box" data-box="crowd">
                      <dt>みんなの評価</dt>
                      <dd data-crowd><span class="none">投稿待ち</span></dd>
                    </div>
                    <div class="score-box is-active" data-box="editor">
                      <dt>運営の評価</dt>
                      <dd><span class="tier-badge" style={`background:${TIERS.find((t) => t.id === tier)!.color}`}>{tier}</span>{j?.score}<small>点</small></dd>
                    </div>
                  </dl>
                </div>
              </div>
              <div class="dist" data-dist hidden></div>
              {j && <p class="judge"><b>運営の判定理由</b>{note}</p>}
            </li>
          ))}
        </ol>

        <!-- みんなの投稿 -->
        <h2 class="sec-title">みんなのティア表</h2>
        <div class="sort-tabs" role="tablist" aria-label="投稿の並び順">
          <button class="sort-tab" role="tab" data-psort="new" aria-selected="true">新着順</button>
          <button class="sort-tab" role="tab" data-psort="top" aria-selected="false">高評価順</button>
        </div>
        <ul class="posts" data-posts><li class="cmt-empty">読み込み中…</li></ul>
        <button type="button" class="cmts-more" data-pmore hidden>もっと見る</button>
      </div>
    </section>
  ))}

  {d.services.length > 0 && (
    <section class="box">
      <h2 class="sec-title" style="margin-top:0">原作で確かめる</h2>
      <p style="font-size:13px;color:var(--ink-2);margin:0">並べ方に迷ったら、根拠になる場面を読み返すのがいちばん確実です。</p>
      {d.services.map((s) => <AffiliateButton service={s} />)}
    </section>
  )}

  {related.length > 0 && (
    <>
      <h2 class="sec-title">ほかの作品のティア表</h2>
      <ul class="rk-list">
        {related.map((x) => (
          <li class="rk-item"><a href={`/rankings/${x.id}/`}><h3>{x.data.work} 最強キャラ ティア表</h3><p class="meta">候補 {x.data.candidates.length}人{x.data.bases.length > 1 ? ` ／ ${x.data.bases.map((b) => b.label).join('・')}別` : ''}</p></a></li>
        ))}
      </ul>
    </>
  )}

  <script type="application/json" id="rk-data" set:html={JSON.stringify({ cands: clientData, tiers: TIERS, labels: Object.fromEntries(d.bases.map((b) => [b.id, b.label])) })} />

  <script>
    type Cand = { id: string; name: string; editorScore: number; editorTier: string };
    type Tier = { id: string; value: number; color: string };
    type Post = { id: number; tiers: Record<string, string[]>; name: string; body: string; spoiler: number; created_at: number; updated_at: number; good: number; bad: number; my_vote: number | null };
    type Agg = { posts: number; distribution: Record<string, number[]>; positions: Record<string, { sum: number; n: number }>; mine: null | { id: number; tiers: Record<string, string[]>; name: string; body: string; spoiler: number } };

    const DATA = JSON.parse(document.getElementById('rk-data')!.textContent!) as { cands: Record<string, Cand[]>; tiers: Tier[]; labels: Record<string, string> };
    const TIERS = DATA.tiers;
    const head = document.querySelector<HTMLElement>('[data-ranking]')!;
    const R = head.dataset.ranking!;
    const WORK = head.dataset.work!;
    const PRIOR_V = 3, CROWD_DEFAULT_AT = 5;
    const loaded = new Map<string, Agg>();

    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const tierColor = (id: string) => TIERS.find((t) => t.id === id)!.color;
    const crowdTier = (avg: number) => (avg >= 4.5 ? 'S' : avg >= 3.5 ? 'A' : avg >= 2.5 ? 'B' : avg >= 1.5 ? 'C' : 'D');
    const ago = (ts: number) => {
      const s = (Date.now() - ts) / 1000;
      if (s < 60) return 'たった今';
      if (s < 3600) return `${Math.floor(s / 60)}分前`;
      if (s < 86400) return `${Math.floor(s / 3600)}時間前`;
      if (s < 86400 * 30) return `${Math.floor(s / 86400)}日前`;
      const d = new Date(ts);
      return `${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()}`;
    };
    const api = async (url: string, init?: RequestInit) => {
      const r = await fetch(url, init);
      const j = await r.json().catch(() => ({}));
      if (!r.ok) throw Object.assign(new Error('api'), { status: r.status, body: j });
      return j;
    };
    const send = (url: string, method: string, body: unknown) =>
      api(url, { method, headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });

    // ---------- 集計 ----------
    function stats(agg: Agg, id: string) {
      const dist = agg.distribution[id] ?? [0, 0, 0, 0, 0];
      const n = dist.reduce((a, b) => a + b, 0);
      const sum = dist.reduce((a, c, i) => a + c * (i + 1), 0);
      const need = Math.ceil(agg.posts / 2);
      const pad = Math.max(0, need - n);
      const p = agg.positions?.[id];
      return { dist, n, avg: n ? sum / n : 0, smooth: n + pad ? (sum + pad * PRIOR_V) / (n + pad) : PRIOR_V, avgPos: p?.n ? p.sum / p.n : Infinity };
    }

    function renderBoard(board: HTMLElement, placement: Record<string, string[]>, names: Map<string, string>) {
      let n = 0;
      board.querySelectorAll<HTMLElement>('.tl-row').forEach((row) => {
        const cells = row.querySelector('.tl-cells')!;
        cells.innerHTML = (placement[row.dataset.tier!] ?? []).map((id) => `<span class="tl-chip"><i>${++n}</i>${esc(names.get(id) ?? id)}</span>`).join('');
      });
    }

    function setView(panel: HTMLElement, view: 'crowd' | 'editor') {
      const basis = panel.dataset.basis!;
      const cands = DATA.cands[basis];
      const names = new Map(cands.map((c) => [c.id, c.name]));
      const agg = loaded.get(basis);
      panel.dataset.view = view;
      panel.querySelectorAll<HTMLElement>('[data-view]').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.view === view)));
      const help = panel.querySelector<HTMLElement>('[data-help]')!;
      const board = panel.querySelector<HTMLElement>('[data-board]')!;
      const placement: Record<string, string[]> = { S: [], A: [], B: [], C: [], D: [] };
      let order: Cand[];
      if (view === 'crowd' && agg && agg.posts > 0) {
        // 段は平均（S=5〜D=1）で決め、段の中は平均順位の順に並べる
        const tierIdx = (id: string) => TIERS.findIndex((t) => t.id === id);
        const keyed = cands.map((c) => ({ c, s: stats(agg, c.id) }));
        keyed.sort((a, b) => tierIdx(crowdTier(a.s.smooth)) - tierIdx(crowdTier(b.s.smooth)) || a.s.avgPos - b.s.avgPos || b.s.smooth - a.s.smooth || b.c.editorScore - a.c.editorScore);
        order = keyed.map((x) => x.c);
        keyed.forEach((x) => placement[crowdTier(x.s.smooth)].push(x.c.id));
        help.textContent = `投稿された${agg.posts}件のティア表の集計です。段はS=5〜D=1点の平均で決め、同じ段の中は平均順位の順に並べています。`;
      } else {
        order = [...cands].sort((a, b) => b.editorScore - a.editorScore);
        order.forEach((c) => placement[c.editorTier].push(c.id));
        help.textContent = view === 'crowd' ? 'まだ投稿がありません。最初のティア表を投稿してみませんか。下は運営のティア表です。' : '作中の描写をもとに運営が並べたティア表です。';
      }
      renderBoard(board, placement, names);

      // キャラ別の評価を同じ順番に並べ替える
      const ol = panel.querySelector('.cands')!;
      const byId = new Map([...ol.querySelectorAll<HTMLElement>('.cand')].map((el) => [el.dataset.c!, el]));
      order.forEach((c, i) => {
        const el = byId.get(c.id);
        if (!el) return;
        el.dataset.pos = String(i + 1);
        el.querySelector('[data-rank]')!.textContent = String(i + 1);
        const useCrowd = view === 'crowd' && !!agg && agg.posts > 0;
        el.querySelector('[data-box="crowd"]')!.classList.toggle('is-active', useCrowd);
        el.querySelector('[data-box="editor"]')!.classList.toggle('is-active', !useCrowd);
        ol.appendChild(el);
      });
    }

    function renderCrowdCells(panel: HTMLElement, agg: Agg) {
      panel.querySelectorAll<HTMLElement>('.cand').forEach((el) => {
        const s = stats(agg, el.dataset.c!);
        const dd = el.querySelector<HTMLElement>('[data-crowd]')!;
        const distEl = el.querySelector<HTMLElement>('[data-dist]')!;
        if (!s.n) { dd.innerHTML = '<span class="none">投稿待ち</span>'; distEl.hidden = true; return; }
        const t = crowdTier(s.smooth);
        const posTxt = Number.isFinite(s.avgPos) ? ` ／ 平均${s.avgPos.toFixed(1)}位` : '';
        dd.innerHTML = `<span class="tier-badge" style="background:${tierColor(t)}">${t}</span>${s.avg.toFixed(2)}<small>（${s.n}人${posTxt}）</small>`;
        distEl.hidden = false;
        distEl.innerHTML =
          '<div class="dist-bar">' +
          [...TIERS].map((tt) => {
            const c = s.dist[tt.value - 1];
            const pct = (c / s.n) * 100;
            return pct ? `<span style="width:${pct}%;background:${tt.color}" title="${tt.id}: ${c}人"></span>` : '';
          }).join('') +
          '</div><div class="dist-legend">' +
          [...TIERS].map((tt) => `<span><b style="color:${tt.color}">${tt.id}</b> ${Math.round((s.dist[tt.value - 1] / s.n) * 100)}%</span>`).join('') +
          '</div>';
      });
    }

    // ---------- 投稿一覧 ----------
    function postEl(p: Post, basis: string): HTMLLIElement {
      const names = new Map(DATA.cands[basis].map((c) => [c.id, c.name]));
      const li = document.createElement('li');
      li.className = 'post';
      const rows = TIERS.map((t) => {
        const ids = p.tiers[t.id] ?? [];
        return `<div class="mini-row"><span class="mini-label" style="background:${t.color}">${t.id}</span><span class="mini-cells">${ids.map((id) => esc(names.get(id) ?? id)).join(' ＞ ') || '<span class="none">—</span>'}</span></div>`;
      }).join('');
      li.innerHTML = `
        <div class="cmt-meta"><b>${esc(p.name)}</b><span>${ago(p.updated_at)}</span></div>
        ${p.spoiler ? '<button type="button" class="cmt-spoiler" data-reveal>ネタバレを含む投稿です（タップで表示）</button>' : ''}
        <div class="post-content"${p.spoiler ? ' hidden' : ''}>
          <div class="mini-board">${rows}</div>
          ${p.body ? `<p class="cmt-body">${esc(p.body)}</p>` : ''}
        </div>
        <div class="cmt-acts">
          <button type="button" class="cmt-act${p.my_vote === 1 ? ' is-on' : ''}" data-v="1">👍 <span>${p.good}</span></button>
          <button type="button" class="cmt-act${p.my_vote === -1 ? ' is-on' : ''}" data-v="-1">👎 <span>${p.bad}</span></button>
          <button type="button" class="cmt-report" data-report>通報</button>
        </div>`;
      li.querySelector('[data-reveal]')?.addEventListener('click', (ev) => {
        (ev.currentTarget as HTMLElement).remove();
        li.querySelector<HTMLElement>('.post-content')!.hidden = false;
      });
      li.querySelectorAll<HTMLButtonElement>('[data-v]').forEach((btn) =>
        btn.addEventListener('click', async () => {
          try {
            const d = await send('/api/posts/', 'PUT', { id: p.id, value: Number(btn.dataset.v) });
            const [g, b] = li.querySelectorAll<HTMLButtonElement>('[data-v]');
            g.querySelector('span')!.textContent = String(d.good);
            b.querySelector('span')!.textContent = String(d.bad);
            g.classList.toggle('is-on', d.my_vote === 1);
            b.classList.toggle('is-on', d.my_vote === -1);
          } catch {}
        })
      );
      li.querySelector('[data-report]')!.addEventListener('click', (ev) => {
        if (li.querySelector('.cmt-report-menu')) return;
        const menu = document.createElement('div');
        menu.className = 'cmt-report-menu';
        menu.innerHTML = [['spoiler', 'ネタバレ'], ['abuse', '誹謗中傷'], ['obscene', 'わいせつ'], ['other', 'その他']]
          .map(([k, v]) => `<button type="button" class="btn" data-reason="${k}">${v}</button>`).join('');
        menu.querySelectorAll<HTMLButtonElement>('[data-reason]').forEach((b) =>
          b.addEventListener('click', async () => {
            try { await send('/api/report/', 'POST', { id: p.id, reason: b.dataset.reason }); } catch {}
            menu.textContent = '通報を受け付けました。ありがとうございます。';
          })
        );
        (ev.currentTarget as HTMLElement).parentElement!.after(menu);
      });
      return li;
    }

    function wirePosts(panel: HTMLElement, basis: string) {
      const list = panel.querySelector<HTMLUListElement>('[data-posts]')!;
      const more = panel.querySelector<HTMLButtonElement>('[data-pmore]')!;
      let sort = 'new', offset = 0;
      const load = async (reset: boolean) => {
        if (reset) offset = 0;
        try {
          const d = await api(`/api/posts/?r=${R}&b=${basis}&sort=${sort}&offset=${offset}`);
          if (reset) list.innerHTML = '';
          if (reset && !d.posts.length) list.innerHTML = '<li class="cmt-empty">まだ投稿がありません。最初のティア表を投稿してみませんか。</li>';
          (d.posts as Post[]).forEach((p) => list.appendChild(postEl(p, basis)));
          offset += d.posts.length;
          more.hidden = !d.more;
        } catch {
          list.innerHTML = '<li class="cmt-empty">投稿を読み込めませんでした。</li>';
        }
      };
      more.onclick = () => load(false);
      panel.querySelectorAll<HTMLButtonElement>('[data-psort]').forEach((b) => {
        b.onclick = () => {
          sort = b.dataset.psort!;
          panel.querySelectorAll('[data-psort]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
          load(true);
        };
      });
      load(true);
      return { prepend: (p: Post) => { list.querySelector('.cmt-empty')?.remove(); list.querySelector(`[data-own]`)?.remove(); const el = postEl(p, basis); el.dataset.own = '1'; list.prepend(el); } };
    }

    // ---------- ティア表づくり ----------
    function wireMaker(panel: HTMLElement, basis: string, onPosted: (p: Post) => void) {
      const maker = panel.querySelector<HTMLElement>('[data-maker]')!;
      const edit = panel.querySelector<HTMLElement>('[data-edit]')!;
      const pool = panel.querySelector<HTMLElement>('[data-pool]')!;
      const poolCells = pool.querySelector<HTMLElement>('.tl-cells')!;
      const left = pool.querySelector<HTMLElement>('[data-left]')!;
      const form = panel.querySelector<HTMLFormElement>('[data-form]')!;
      const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
      const msg = form.querySelector<HTMLElement>('.rf-msg')!;
      const chips = new Map([...poolCells.querySelectorAll<HTMLButtonElement>('.tl-chip')].map((c) => [c.dataset.id!, c]));
      const selbar = panel.querySelector<HTMLElement>('[data-selbar]')!;
      let selected: HTMLButtonElement | null = null;
      const inRow = (c: Element | null) => !!c && c.parentElement !== poolCells;
      const nameOf = (c: HTMLElement) => c.lastChild?.textContent ?? '';

      const select = (c: HTMLButtonElement | null) => {
        selected?.classList.remove('is-selected');
        selected = c === selected ? null : c;
        selected?.classList.add('is-selected');
        edit.classList.toggle('has-selection', !!selected);
        pool.classList.toggle('has-selection', !!selected && inRow(selected));
        selbar.hidden = !(selected && inRow(selected));
        if (selected) selbar.querySelector('[data-selname]')!.textContent = nameOf(selected);
      };
      const refresh = () => {
        let rank = 0;
        edit.querySelectorAll<HTMLElement>('.tl-row .tl-chip').forEach((c) => (c.querySelector('i')!.textContent = String(++rank)));
        poolCells.querySelectorAll<HTMLElement>('.tl-chip i').forEach((i) => (i.textContent = ''));
        const n = poolCells.querySelectorAll('.tl-chip').length;
        left.textContent = String(n);
        pool.classList.toggle('is-empty', n === 0);
        submit.disabled = n > 0;
        submit.textContent = n > 0 ? `あと${n}人並べると投稿できます` : 'このティア表を投稿する';
      };
      const place = (chip: HTMLButtonElement, target: HTMLElement) => {
        target.querySelector('.tl-cells')!.appendChild(chip);
        select(null);
        refresh();
      };
      // 段の中のキャラの左に差し込む
      const insertBefore = (chip: HTMLButtonElement, ref: HTMLElement) => {
        if (chip === ref) return;
        ref.before(chip);
        select(null);
        refresh();
      };
      chips.forEach((chip) => {
        chip.addEventListener('click', (ev) => {
          ev.stopPropagation();
          if (selected && selected !== chip && inRow(chip)) insertBefore(selected, chip);
          else select(chip);
        });
        chip.addEventListener('dragstart', (ev) => { ev.dataTransfer!.setData('text/plain', chip.dataset.id!); ev.dataTransfer!.effectAllowed = 'move'; });
        chip.addEventListener('dragover', (ev) => {
          if (!inRow(chip)) return;
          ev.preventDefault();
          ev.stopPropagation();
          chip.classList.add('is-target');
        });
        chip.addEventListener('dragleave', () => chip.classList.remove('is-target'));
        chip.addEventListener('drop', (ev) => {
          if (!inRow(chip)) return;
          ev.preventDefault();
          ev.stopPropagation();
          chip.classList.remove('is-target');
          panel.querySelectorAll('.is-over').forEach((z) => z.classList.remove('is-over'));
          const dragged = chips.get(ev.dataTransfer!.getData('text/plain'));
          if (dragged) insertBefore(dragged, chip);
        });
      });
      selbar.querySelectorAll<HTMLButtonElement>('[data-move]').forEach((b) =>
        b.addEventListener('click', () => {
          if (!selected) return;
          const sib = Number(b.dataset.move) < 0 ? selected.previousElementSibling : selected.nextElementSibling;
          if (sib) Number(b.dataset.move) < 0 ? sib.before(selected) : sib.after(selected);
          refresh();
        })
      );
      selbar.querySelector<HTMLButtonElement>('[data-unplace]')!.addEventListener('click', () => {
        if (selected) place(selected, pool);
      });
      panel.querySelectorAll<HTMLElement>('.tl-maker [data-drop]').forEach((zone) => {
        zone.addEventListener('click', () => { if (selected) place(selected, zone); });
        zone.addEventListener('dragover', (ev) => { ev.preventDefault(); zone.classList.add('is-over'); });
        zone.addEventListener('dragleave', () => zone.classList.remove('is-over'));
        zone.addEventListener('drop', (ev) => {
          ev.preventDefault();
          zone.classList.remove('is-over');
          const chip = chips.get(ev.dataTransfer!.getData('text/plain'));
          if (chip) place(chip, zone);
        });
      });
      const reset = () => { [...chips.values()].forEach((c) => poolCells.appendChild(c)); select(null); refresh(); };
      const load = (tiers: Record<string, string[]>) => {
        reset();
        TIERS.forEach((t) => (tiers[t.id] ?? []).forEach((id) => {
          const chip = chips.get(id);
          if (chip) edit.querySelector(`.tl-row[data-tier="${t.id}"] .tl-cells`)!.appendChild(chip);
        }));
        refresh();
      };
      form.querySelector<HTMLButtonElement>('[data-reset]')!.onclick = reset;
      form.querySelector<HTMLButtonElement>('[data-close]')!.onclick = () => { maker.hidden = true; };
      try { const n = localStorage.getItem('rk-name'); if (n) form.querySelector<HTMLInputElement>('input[name=name]')!.value = n; } catch {}

      form.onsubmit = async (ev) => {
        ev.preventDefault();
        const tiers: Record<string, string[]> = {};
        edit.querySelectorAll<HTMLElement>('.tl-row').forEach((row) => {
          tiers[row.dataset.tier!] = [...row.querySelectorAll<HTMLElement>('.tl-chip')].map((c) => c.dataset.id!);
        });
        const fd = new FormData(form);
        const name = String(fd.get('name') || '').trim();
        try { name ? localStorage.setItem('rk-name', name) : localStorage.removeItem('rk-name'); } catch {}
        submit.disabled = true;
        try {
          const d = await send('/api/tier/', 'POST', { r: R, b: basis, tiers, name, body: fd.get('body'), spoiler: fd.get('spoiler') === 'on', website: fd.get('website') });
          msg.hidden = false;
          const lines = TIERS.map((t) => (tiers[t.id].length ? `${t.id}: ${tiers[t.id].map((id) => DATA.cands[basis].find((c) => c.id === id)!.name).join('＞')}` : '')).filter(Boolean);
          const text = `【${WORK} 最強ティア表（${DATA.labels[basis]}）】\n${lines.slice(0, 3).join('\n')}\n#アニメ最強ランキング`;
          const url = `${location.origin}${location.pathname}${basis === Object.keys(DATA.cands)[0] ? '' : '#' + basis}`;
          msg.innerHTML = `投稿しました。<a href="https://x.com/intent/post?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url)}" target="_blank" rel="noopener">Xでシェアする</a>`;
          msg.classList.add('is-ok');
          onPosted(d.post);
        } catch (e: any) {
          msg.hidden = false;
          msg.classList.remove('is-ok');
          msg.textContent = e?.body?.message ?? (e?.status === 503 ? '投稿の受付を準備中です。' : '送信できませんでした。時間をおいてもう一度お試しください。');
        } finally {
          refresh();
        }
      };
      refresh();
      return { load, open: () => { maker.hidden = false; maker.scrollIntoView({ behavior: 'smooth', block: 'start' }); } };
    }

    // ---------- 勢ごとの初期化 ----------
    async function loadBasis(basis: string) {
      const panel = document.querySelector<HTMLElement>(`.basis-panel[data-basis="${basis}"]`)!;
      head.querySelector('[data-stat="count"]')!.innerHTML = `${DATA.cands[basis].length}<small>人</small>`;
      if (panel.dataset.wired) {
        const a = loaded.get(basis);
        head.querySelector('[data-stat="posts"]')!.innerHTML = `${a?.posts ?? '-'}<small>件</small>`;
        return;
      }
      panel.dataset.wired = '1';
      panel.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((t) => (t.onclick = () => setView(panel, t.dataset.view as 'crowd' | 'editor')));
      const posts = wirePosts(panel, basis);
      const refreshAgg = async () => {
        try {
          const agg: Agg = await api(`/api/tier/?r=${R}&b=${basis}`);
          loaded.set(basis, agg);
          head.querySelector('[data-stat="posts"]')!.innerHTML = `${agg.posts}<small>件</small>`;
          renderCrowdCells(panel, agg);
          return agg;
        } catch {
          return null;
        }
      };
      const maker = wireMaker(panel, basis, async (p) => {
        posts.prepend(p);
        await refreshAgg();
        setView(panel, 'crowd');
      });
      panel.querySelector<HTMLButtonElement>('[data-make]')!.onclick = () => maker.open();
      const agg = await refreshAgg();
      if (agg?.mine) {
        maker.load(agg.mine.tiers);
        const f = panel.querySelector<HTMLFormElement>('[data-form]')!;
        f.querySelector<HTMLTextAreaElement>('textarea')!.value = agg.mine.body;
        f.querySelector<HTMLInputElement>('input[name=spoiler]')!.checked = !!agg.mine.spoiler;
        panel.querySelector<HTMLButtonElement>('[data-make]')!.textContent = '自分のティア表を並べ直す';
      }
      setView(panel, agg && agg.posts >= CROWD_DEFAULT_AT ? 'crowd' : 'editor');
    }

    // ---------- 勢タブ ----------
    const gateKey = (b: string) => `rk-gate:${R}:${b}`;
    const firstBasis = document.querySelector<HTMLElement>('.basis-tab')!.dataset.basis!;
    function openBasis(basis: string) {
      document.querySelectorAll<HTMLElement>('.basis-tab').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.basis === basis)));
      document.querySelectorAll<HTMLElement>('.basis-panel').forEach((p) => (p.hidden = p.dataset.basis !== basis));
      const panel = document.querySelector<HTMLElement>(`.basis-panel[data-basis="${basis}"]`)!;
      const gate = panel.querySelector<HTMLElement>('[data-gate]');
      let passed = !gate;
      try { passed ||= sessionStorage.getItem(gateKey(basis)) === '1'; } catch {}
      if (passed) {
        if (gate) gate.hidden = true;
        panel.querySelector<HTMLElement>('[data-body]')!.hidden = false;
        loadBasis(basis);
      }
      history.replaceState(null, '', basis === firstBasis ? location.pathname : `#${basis}`);
    }
    document.querySelectorAll<HTMLElement>('.basis-panel [data-open]').forEach((b) =>
      b.addEventListener('click', () => {
        const basis = b.closest<HTMLElement>('.basis-panel')!.dataset.basis!;
        try { sessionStorage.setItem(gateKey(basis), '1'); } catch {}
        openBasis(basis);
      })
    );
    document.querySelectorAll<HTMLElement>('.basis-tab').forEach((t) => t.addEventListener('click', () => openBasis(t.dataset.basis!)));
    const fromHash = location.hash.slice(1);
    openBasis(document.querySelector(`.basis-tab[data-basis="${fromHash}"]`) ? fromHash : firstBasis);
  </script>
</Base>
