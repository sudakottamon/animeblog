---
import Base from '../layouts/Base.astro';
import RankingList from '../components/RankingList.astro';
import { getCollection } from 'astro:content';

const rankings = await getCollection('rankings');
const titles = Object.fromEntries(rankings.map((r) => [r.id, r.data.work]));
const names = Object.fromEntries(rankings.map((r) => [r.id, Object.fromEntries(r.data.candidates.map((c) => [c.id, c.name]))]));
const basisLabels = Object.fromEntries(rankings.map((r) => [r.id, Object.fromEntries(r.data.bases.map((b) => [b.id, b.label]))]));

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf())
  .slice(0, 6);
---
<Base
  title="アニメ最強ランキング"
  description="アニメ・漫画の最強キャラを、アニメ勢・漫画勢・原作勢に分けてみんなで採点するランキング。運営の判定とみんなの採点、2つの順位を見比べられます。"
  showPr={false}
>
  <h1 style="font-size:20px;margin:14px 0 4px">アニメの最強キャラを、みんなで採点</h1>
  <p style="font-size:13px;color:var(--ink-2);margin:0">アニメ勢・漫画勢・原作勢に分けて採点するので、まだ見ていない展開のネタバレが混ざりません。ログイン不要です。</p>

  <h2 class="sec-title">作品別ランキング</h2>
  <RankingList />

  <h2 class="sec-title">新着コメント</h2>
  <div class="box" style="padding:8px 14px">
    <ul class="feed" data-feed><li class="who">読み込み中…</li></ul>
  </div>

  <h2 class="sec-title">読みもの</h2>
  <div class="box" style="padding:4px 14px">
    <ul class="links">
      {articles.map((a) => <li><a href={`/${a.id}/`}>{a.data.title}</a></li>)}
    </ul>
  </div>
  <p style="text-align:right;font-size:13px"><a href="/yomimono/">読みもの一覧 ›</a></p>

  <script define:vars={{ titles, names, basisLabels }}>
    const esc = (s) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    const feed = document.querySelector('[data-feed]');
    fetch('/api/summary/')
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((d) => {
        if (!d.recent.length) { feed.innerHTML = '<li class="who">まだコメントはありません。</li>'; return; }
        feed.innerHTML = d.recent
          .map((c) => {
            const who = `${esc(c.name)} ／ ${esc(titles[c.ranking] ?? '')}（${esc(basisLabels[c.ranking]?.[c.basis] ?? '')}）の${esc(names[c.ranking]?.[c.candidate] ?? '')}に${c.score ?? '-'}点`;
            const body = c.spoiler ? '（ネタバレを含むコメント）' : esc(c.body);
            return `<li><a href="/rankings/${c.ranking}/#${c.basis}" style="color:inherit"><div class="who">${who}</div><div class="what">${body}</div></a></li>`;
          })
          .join('');
      })
      .catch(() => { feed.innerHTML = '<li class="who">新着コメントを読み込めませんでした。</li>'; });
  </script>
</Base>
