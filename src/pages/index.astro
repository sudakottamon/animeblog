---
import Base from '../layouts/Base.astro';
import Thumb from '../components/Thumb.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const groups = [
  { key: 'saikyo', label: '作品別・最強議決' },
  { key: 'watch', label: '作品別：どこで見れる？' },
  { key: 'ranking', label: 'おすすめランキング' },
  { key: 'guide', label: 'ガイド・コラム' },
] as const;

const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<Base
  title="アニメ最強キャラランキング【作中描写で議決】"
  description="作品ごとの最強キャラランキングを、作中描写だけを証拠に議決するサイト。アニメ基準と原作基準の両方で査定し、判決理由まで全部書きます。"
>
  <div class="hero">
    <h1>作中描写だけで、最強を議決する。</h1>
    <p class="lede">「結局誰が最強なのか」を、公式資料でも人気でもなく作中の描写を証拠に査定する裁判所です。アニメ勢用と原作勢用、両方の基準で議決します。判定の物差しは<a href="/rules/">議事規則</a>で公開中。</p>
  </div>

  {groups.map((g) => {
    const list = articles.filter((a) => a.data.category === g.key);
    return list.length > 0 && (
      <section id={`cat-${g.key}`}>
        <h2>{g.label}</h2>
        <ul class="post-list">
          {list.map((a) => (
            <li>
              <a class="post-card" href={`/${a.id}/`}>
                <Thumb category={a.data.category} />
                <div class="post-body">
                  <span class="post-title">{a.data.title}</span>
                  <span class="post-desc">{a.data.description}</span>
                  <span class="post-date">{fmt(a.data.updatedDate ?? a.data.pubDate)}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</Base>
