---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const groups = [
  { key: 'watch', label: '作品別：どこで見れる？' },
  { key: 'ranking', label: 'おすすめランキング' },
  { key: 'guide', label: 'ガイド・コラム' },
] as const;
---
<Base
  title="アニメの配信情報・VOD比較"
  description="「このアニメはどこで見れる？」に最速で答える配信情報サイト。動画配信サービスの比較・おすすめアニメランキングも。"
>
  <div class="hero">
    <h1>そのアニメ、どこで見れる？</h1>
    <p class="lede">作品ごとの配信サービスを最速で逆引き。サブスク選びで失敗しないための比較とランキングも。</p>
    <div class="cta"><a class="btn-affiliate" href="/vod/">アニメに強いVODを比較する</a></div>
  </div>

  <span id="latest"></span>
  {groups.map((g) => {
    const list = articles.filter((a) => a.data.category === g.key);
    return list.length > 0 && (
      <>
        <h2>{g.label}</h2>
        <ul class="card-list">
          {list.map((a) => (
            <li>
              <a href={`/${a.id}/`}>{a.data.title}</a>
              <p class="desc">{a.data.description}</p>
            </li>
          ))}
        </ul>
      </>
    );
  })}
</Base>
