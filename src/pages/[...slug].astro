---
import Base from '../layouts/Base.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import VodTable from '../components/VodTable.astro';
import RankingList from '../components/RankingList.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const d = article.data;

const all = await getCollection('articles', ({ data }) => !data.draft);
const related = all
  .filter((a) => a.id !== article.id && a.data.category === d.category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
const fmt = (date: Date) => `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  mainEntityOfPage: Astro.url.toString(),
  author: { '@type': 'Organization', name: 'アニメ最強ランキング' },
};
---
<Base title={d.title} description={d.description} ogType="article" jsonLd={jsonLd}>
  <nav class="crumbs" aria-label="パンくず">
    <span><a href="/">トップ</a></span><span><a href="/yomimono/">読みもの</a></span><span>{d.title.slice(0, 24)}{d.title.length > 24 ? '…' : ''}</span>
  </nav>
  <article class="article">
    <h1>{d.title}</h1>
    <p class="meta">
      {fmt(d.pubDate)} 公開{d.updatedDate && `（${fmt(d.updatedDate)} 更新）`}
    </p>

    <nav class="toc" id="toc" hidden>
      <details open>
        <summary>目次</summary>
        <ol id="toc-list"></ol>
      </details>
    </nav>

    <div id="article-body">
      <Content />

      {d.services.length > 0 && (
        <>
          <h2>この記事に出てきた配信サービス</h2>
          <VodTable only={d.services} />
          {d.services.map((s) => <AffiliateButton service={s} />)}
        </>
      )}
    </div>

    <p class="notice">配信状況・料金は記事作成時点の情報です。配信は予告なく終了することがあるので、最新の状況は各サービスの公式サイトでご確認ください。</p>
  </article>

  <h2 class="sec-title">最強キャラを採点する</h2>
  <RankingList />

  {related.length > 0 && (
    <>
      <h2 class="sec-title">ほかの読みもの</h2>
      <div class="box" style="padding:4px 14px">
        <ul class="links">{related.map((a) => <li><a href={`/${a.id}/`}>{a.data.title}</a></li>)}</ul>
      </div>
    </>
  )}

  <script>
    const body = document.getElementById('article-body');
    const toc = document.getElementById('toc');
    const list = document.getElementById('toc-list');
    if (body && toc && list) {
      const heads = body.querySelectorAll('h2');
      if (heads.length >= 2) {
        heads.forEach((h, i) => {
          const id = h.id || `sec-${i + 1}`;
          h.id = id;
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${id}`;
          a.textContent = h.textContent;
          li.appendChild(a);
          list.appendChild(li);
        });
        toc.hidden = false;
      }
    }
  </script>
</Base>
