---
import Base from '../layouts/Base.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import VodTable from '../components/VodTable.astro';
import Thumb from '../components/Thumb.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const d = article.data;

const all = await getCollection('articles', ({ data }) => !data.draft);
const related = all
  .filter((a) => a.id !== article.id)
  .sort((a, b) => {
    const score = (x: typeof a) =>
      (x.data.category === d.category ? 2 : 0) +
      x.data.services.filter((s) => d.services.includes(s)).length * 0.1 +
      x.data.pubDate.valueOf() / 1e15;
    return score(b) - score(a);
  })
  .slice(0, 4);
const fmt = (date: Date) =>
  `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  mainEntityOfPage: Astro.url.toString(),
  author: { '@type': 'Organization', name: 'アニメ配信ナビ編集部' },
};
---
<Base title={d.title} description={d.description} ogType="article" jsonLd={jsonLd}>
  <article>
    <Thumb category={d.category} title={d.title} hero={true} />
    <h1>{d.title}</h1>
    <p class="meta">
      {fmt(d.pubDate)} 公開
      {d.updatedDate && `（${fmt(d.updatedDate)} 更新）`}
    </p>

    <nav class="toc" id="toc" hidden>
      <details open>
        <summary>目次</summary>
        <ol id="toc-list"></ol>
      </details>
    </nav>

    <div id="article-body">
      <Content />

      {d.services.length > 0 && (
        <>
          <h2>この記事に出てきた配信サービス</h2>
          <VodTable only={d.services} />
          {d.services.map((s) => <AffiliateButton service={s} />)}
        </>
      )}
    </div>

    <div class="notice">
      配信状況・料金は記事作成時点の情報です。配信は予告なく終了する場合があるため、
      最新の状況は各サービスの公式サイトでご確認ください。
    </div>

    <p><a href="/vod/">→ アニメに強いVODの比較まとめはこちら</a></p>

    {related.length > 0 && (
      <>
        <h2>あわせて読む</h2>
        <ul class="post-list">
          {related.map((a) => (
            <li>
              <a class="post-card" href={`/${a.id}/`}>
                <Thumb category={a.data.category} />
                <div class="post-body">
                  <span class="post-title">{a.data.title}</span>
                  <span class="post-desc">{a.data.description}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </article>

  <script>
    const body = document.getElementById('article-body');
    const toc = document.getElementById('toc');
    const list = document.getElementById('toc-list');
    if (body && toc && list) {
      const heads = body.querySelectorAll('h2');
      if (heads.length >= 2) {
        heads.forEach((h, i) => {
          const id = h.id || `sec-${i + 1}`;
          h.id = id;
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${id}`;
          a.textContent = h.textContent;
          li.appendChild(a);
          list.appendChild(li);
        });
        toc.hidden = false;
      }
    }
  </script>
</Base>
