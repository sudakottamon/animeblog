---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---
<section class="comments" data-slug={slug} id="comments">
  <div class="comments-head">
    <span class="poll-kicker">議場（コメント）</span>
    <h2 class="comments-title">この判決、どう思う？ <span class="comments-count" data-count></span></h2>
    <p class="poll-meta">登録不要・匿名OK。推しの弁護も、判決への控訴も歓迎。誹謗中傷は書記局が削除します。</p>
  </div>

  <form class="comment-form" data-form>
    <div class="comment-form-row">
      <input type="text" name="name" maxlength="20" placeholder="名前（省略で「匿名議員」）" autocomplete="off" />
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
    </div>
    <textarea name="body" maxlength="600" rows="3" placeholder="例：五条が1位なのは納得。でも甚爾はもう少し上でしょ……" required></textarea>
    <div class="comment-form-foot">
      <span class="comment-hint"><span data-len>0</span>/600</span>
      <button type="submit" class="btn-post">発言する</button>
    </div>
    <p class="poll-status" data-status hidden></p>
  </form>

  <ul class="comment-list" data-list>
    <li class="comment-empty" data-empty>読み込み中…</li>
  </ul>
</section>

<script>
  const AVATARS = ['🦊','🐯','🐼','🐸','🐙','🦉','🐺','🐨','🦁','🐧','🦄','🐲','🐰','🐻','🐱','🦖'];
  const avatar = (name: string) => {
    let h = 0;
    for (const ch of name) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
    return AVATARS[h % AVATARS.length];
  };
  const rel = (ts: number) => {
    const d = (Date.now() - ts) / 1000;
    if (d < 60) return 'いま';
    if (d < 3600) return `${Math.floor(d / 60)}分前`;
    if (d < 86400) return `${Math.floor(d / 3600)}時間前`;
    if (d < 86400 * 30) return `${Math.floor(d / 86400)}日前`;
    const dt = new Date(ts);
    return `${dt.getFullYear()}/${dt.getMonth() + 1}/${dt.getDate()}`;
  };
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  document.querySelectorAll<HTMLElement>('.comments').forEach((root) => {
    const slug = root.dataset.slug!;
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const ta = form.querySelector<HTMLTextAreaElement>('textarea')!;
    const len = form.querySelector<HTMLElement>('[data-len]')!;
    ta.addEventListener('input', () => (len.textContent = String(ta.value.length)));

    type C = { id: number; name: string; body: string; created_at: number; likes: number; liked: number | boolean };
    const item = (c: C) => {
      const li = document.createElement('li');
      li.className = 'comment';
      li.dataset.id = String(c.id);
      li.innerHTML = `
        <div class="comment-avatar">${avatar(c.name)}</div>
        <div class="comment-bubble">
          <div class="comment-meta"><b>${esc(c.name)}</b><span>${rel(c.created_at)}</span></div>
          <p class="comment-body">${esc(c.body).replace(/\n/g, '<br>')}</p>
          <button type="button" class="comment-like${c.liked ? ' is-on' : ''}" data-like>👍 同意 <span>${c.likes}</span></button>
        </div>`;
      li.querySelector<HTMLButtonElement>('[data-like]')!.addEventListener('click', async (ev) => {
        const btn = ev.currentTarget as HTMLButtonElement;
        const r = await fetch('/api/comments/', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: c.id }) });
        if (!r.ok) return;
        const d = await r.json();
        btn.classList.toggle('is-on', d.liked);
        btn.querySelector('span')!.textContent = String(d.likes);
      });
      return li;
    };

    const setStatus = (msg: string) => { status.hidden = false; status.textContent = msg; };

    fetch(`/api/comments/?slug=${encodeURIComponent(slug)}`)
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((d: { comments: C[] }) => {
        empty.remove();
        count.textContent = d.comments.length ? `${d.comments.length}件` : '';
        if (!d.comments.length) {
          list.innerHTML = '<li class="comment-empty">まだ発言がありません。最初の一石を投じてください。</li>';
          return;
        }
        d.comments.forEach((c) => list.appendChild(item(c)));
      })
      .catch(() => {
        empty.textContent = '議場は準備中です。もう少しお待ちください。';
        form.querySelector<HTMLButtonElement>('button[type=submit]')!.disabled = true;
      });

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const fd = new FormData(form);
      const body = String(fd.get('body') ?? '').trim();
      if (!body) return;
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      try {
        const r = await fetch('/api/comments/', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ slug, name: fd.get('name'), body, website: fd.get('website') }),
        });
        const d = await r.json();
        if (!r.ok) { setStatus(d.message ?? '投稿できませんでした'); return; }
        list.querySelector('.comment-empty')?.remove();
        list.prepend(item(d.comment));
        ta.value = ''; len.textContent = '0';
        status.hidden = true;
        const n = list.querySelectorAll('.comment').length;
        count.textContent = `${n}件`;
      } catch {
        setStatus('通信に失敗しました');
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
