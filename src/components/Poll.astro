---
interface Props {
  slug: string;
  question: string;
  options: string[];
}
const { slug, question, options } = Astro.props;
---
<section class="poll" data-slug={slug}>
  <div class="poll-head">
    <span class="poll-kicker">みんなの投票</span>
    <h2 class="poll-q">{question}</h2>
    <p class="poll-meta"><span data-total>—</span>票 ／ 1人1票・あとから変更OK</p>
  </div>
  <ul class="poll-list">
    {options.map((o) => (
      <li>
        <button type="button" class="poll-opt" data-choice={o}>
          <span class="poll-bar" style="width:0%"></span>
          <span class="poll-label">{o}</span>
          <span class="poll-pct" data-pct>0%</span>
        </button>
      </li>
    ))}
  </ul>
  <p class="poll-status" data-status hidden></p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.poll').forEach((root) => {
    const slug = root.dataset.slug!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const totalEl = root.querySelector<HTMLElement>('[data-total]')!;
    const opts = [...root.querySelectorAll<HTMLButtonElement>('.poll-opt')];

    const render = (data: { total: number; counts: Record<string, number>; mine: string | null }) => {
      totalEl.textContent = String(data.total);
      opts.forEach((btn) => {
        const c = btn.dataset.choice!;
        const n = data.counts[c] ?? 0;
        const pct = data.total ? Math.round((n / data.total) * 100) : 0;
        btn.querySelector<HTMLElement>('.poll-bar')!.style.width = pct + '%';
        btn.querySelector<HTMLElement>('[data-pct]')!.textContent = pct + '%';
        btn.classList.toggle('is-mine', data.mine === c);
      });
      if (data.mine) { status.hidden = false; status.textContent = `あなたの1票：${data.mine}（押し直しで変更できます）`; }
    };
    const notReady = () => {
      status.hidden = false;
      status.textContent = '投票所は準備中です。もう少しお待ちください。';
      opts.forEach((b) => (b.disabled = true));
    };

    fetch(`/api/vote/?slug=${encodeURIComponent(slug)}`)
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then(render)
      .catch(notReady);

    opts.forEach((btn) =>
      btn.addEventListener('click', async () => {
        btn.classList.add('is-busy');
        try {
          const r = await fetch('/api/vote/', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ slug, choice: btn.dataset.choice }),
          });
          if (!r.ok) throw new Error(String(r.status));
          render(await r.json());
        } catch {
          notReady();
        } finally {
          btn.classList.remove('is-busy');
        }
      })
    );
  });
</script>
