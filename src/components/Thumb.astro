---
interface Props {
  category: string;
  title?: string;
  hero?: boolean;
}
const { category, title, hero = false } = Astro.props;
const metaMap: Record<string, { label: string; bg: string }> = {
  saikyo: { label: '最強議決', bg: '#ff5a5f' },
  watch: { label: 'どこで見れる', bg: '#2b7de9' },
  ranking: { label: 'ランキング', bg: '#f5a623' },
  guide: { label: '読みもの', bg: '#1fa79a' },
  vod: { label: 'VOD比較', bg: '#8e5cd9' },
};
const m = metaMap[category] ?? { label: 'コラム', bg: '#666' };
---
{hero ? (
  <div class="thumb-hero" style={`background:${m.bg}`}>
    <span class="thumb-hero-label">{m.label}</span>
    {title && <span class="thumb-hero-title">{title}</span>}
  </div>
) : (
  <div class="thumb" style={`background:${m.bg}`}>
    <span class="thumb-label">{m.label}</span>
  </div>
)}
