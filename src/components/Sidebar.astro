---
import { getCollection } from 'astro:content';
import Thumb from './Thumb.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 人気記事（手動キュレーション。アクセス解析導入後は実データに置き換える）
const pickIds = [
  'saikyo/jujutsu-kaisen',
  'saikyo/kimetsu',
  'watch/kimetsu-mugenjou',
  'watch/chainsaw-man-reze',
  'ranking/isekai-anime',
];
const picks = pickIds
  .map((id) => articles.find((a) => a.id === id))
  .filter(Boolean) as typeof articles;
---
<aside class="sidebar">
  <section class="side-box">
    <h2 class="side-title">よく読まれている記事</h2>
    <ul class="side-list">
      {picks.map((a, i) => (
        <li>
          <a href={`/${a.id}/`}>
            <span class="side-rank">{i + 1}</span>
            <span class="side-text">{a.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="side-box">
    <h2 class="side-title">カテゴリ</h2>
    <ul class="side-cats">
      <li><a href="/#cat-saikyo">作品別・最強議決</a></li>
      <li><a href="/rules/">議事規則（査定基準）</a></li>
      <li><a href="/#cat-watch">作品別：どこで見れる？</a></li>
      <li><a href="/#cat-ranking">おすすめランキング</a></li>
      <li><a href="/#cat-guide">ガイド・コラム</a></li>
      <li><a href="/vod/">VOD比較（まとめ）</a></li>
    </ul>
  </section>

  <section class="side-box">
    <h2 class="side-title">このサイトについて</h2>
    <p class="side-about">
      「結局誰が最強なの？」を、人気投票でも公式設定でもなく<strong>作中描写だけ</strong>で議決するサイトです。
      物差しは<a href="/rules/">議事規則</a>で全文公開。納得いかない判決への控訴は、各自の心の中で。
      <a href="/about/">運営者情報</a>
    </p>
  </section>
</aside>
