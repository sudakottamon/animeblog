{
  // ローカル動作確認用: npx wrangler dev --config wrangler.local.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "animeblog",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "tsuyosa-gikai", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ]
}
