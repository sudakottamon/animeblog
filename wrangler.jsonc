{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "animeblog",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "anime.chottotools.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tsuyosa-gikai",
      "database_id": "83850745-dc28-46e7-a1fc-310aee69aeca",
      "migrations_dir": "migrations"
    }
  ]
}
